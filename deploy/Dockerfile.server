# MAKEREADME backend — build image on CI runner, never on the deploy box
FROM node:20-alpine

WORKDIR /app

# Install deps first (cache layer for faster rebuilds)
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

# Copy server source AFTER deps so code changes don't re-install
COPY server/ ./

ENV NODE_ENV=production
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5000/health || exit 1

CMD ["node", "index.js"]