# Copied to the VPS as deploy/prod.env and consumed by the deploy job.
# Fill these in the repo's GitHub → Settings → Secrets.

# MAKEREADME runtime
# One key, or several comma-separated keys (used as 429 fallbacks): key_one,key_two
GEMINI_API_KEY=<your-gemini-key>
GITHUB_TOKEN=<token-with-repo-scope-to-generate-readmes>
PORT=5000